# Ejemplo para bendey.cloud (Nuxt SSG — salida estática en .output/public)
server {
    listen 443 ssl http2;
    server_name bendey.cloud www.bendey.cloud;

    # `npm run generate` deja el sitio en .output/public
    root /var/www/landing/.output/public;
    index index.html;

    # Rutas prerenderizadas: se sirve el archivo directo. Lo no prerenderizado
    # (p. ej. /r/CODIGO de referido) cae al shell 200.html que hidrata en cliente.
    location / {
        try_files $uri $uri.html $uri/index.html /200.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
