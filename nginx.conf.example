# Ejemplo para bendey.cloud (Nuxt SSG — salida estática en .output/public)
server {
    listen 443 ssl http2;
    server_name bendey.cloud www.bendey.cloud;

    # Copia aquí el CONTENIDO de .output/public (lo que deja `npm run generate`).
    root /var/www/bendey-landing;
    index index.html;

    # Rutas prerenderizadas: se sirve el archivo directo. Lo no prerenderizado
    # (p. ej. /r/CODIGO de referido) cae al shell 200.html que hidrata en cliente.
    location / {
        try_files $uri $uri.html $uri/index.html /200.html;
    }

    # NOTA: el landing llama al API en https://api.bendey.cloud (absoluto), así que
    # aquí NO hace falta proxy /api. El backend debe permitir CORS desde bendey.cloud.
}
